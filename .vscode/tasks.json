{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: build:watch",
      "type": "shell",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Bundled",
          "endsPattern": "extension\\.js\\.map.*\\(source map\\)"
        }
      },
      "command": "bun",
      "args": [
        "run",
        "build:watch"
      ]
    }
  ]
}
